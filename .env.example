# =============================================================================
# AgentFlow AI — environment template
# Copy to `.env` and fill in real values. `.env` is gitignored; this file is
# the committed contract of every variable the app reads.
#
# Every value here is a *working local default*, so `make up && make dev` runs
# on a fresh clone with no editing. Production overrides everything through real
# environment variables — the 12-factor contract — and `Settings` refuses to
# start a production process that kept certain defaults. Those are marked
# REFUSED IN PRODUCTION below.
#
# Variables for milestones that are not built yet are grouped at the bottom and
# marked NOT READ YET. `extra="ignore"` means they are harmless; it also means a
# typo in one is silent, which is why they are kept separate from live settings.
# =============================================================================

# --- App (M1) ---
APP_ENV=development            # development | test | production
APP_NAME=agentflow
LOG_LEVEL=INFO
DEBUG=false

# --- Auth (M3) ---
# JWT signing key. Generate one with: openssl rand -hex 32
# Must be >= 32 bytes (RFC 7518 §3.2). REFUSED IN PRODUCTION as a placeholder or
# if shorter — a leaked or default signing key mints tokens for any user and
# nothing in the application would notice.
SECRET_KEY=dev-only-insecure-secret-change-me-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30 # short: access tokens cannot be revoked
REFRESH_TOKEN_EXPIRE_DAYS=7    # long, but revocable via the jti denylist in Redis

# --- Database (M2) ---
DATABASE_URL=postgresql+asyncpg://agentflow:agentflow@localhost:5432/agentflow
# Pool sizing: (DB_POOL_SIZE + DB_MAX_OVERFLOW) x processes must stay below the
# server's max_connections (default 100). Async apps need a small pool.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false                  # log every SQL statement — debugging only

# --- Redis (M3: token denylist; M5: queue broker) ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (M5) ---
# Document METADATA lives in Postgres; the bytes live here. `local` writes to
# the filesystem and is what `make dev` and the test suite use; a bucket-backed
# backend arrives with the M16 deploy work (ADR-0007).
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./var/storage
# Enforced while the upload is being read, not after — see DocumentService.
MAX_UPLOAD_BYTES=26214400      # 25 MiB
# JSON list. Must stay a subset of what app/rag/ingestion.py can parse; a type
# accepted here and unparseable there is a guaranteed status=failed.
ALLOWED_UPLOAD_MIME_TYPES=["application/pdf","text/plain","text/markdown"]

# --- Background worker (arq, M5) ---
ARQ_MAX_TRIES=3                # retries fix transient failures, not corrupt PDFs
ARQ_JOB_TIMEOUT_SECONDS=300    # without a timeout a job hangs instead of failing

# --- Retrieval (M6) ---
# `hashing` is an offline embedder that matches *words*, not meaning, so a
# fresh clone and the whole test suite run with no key and no network.
# REFUSED IN PRODUCTION: search would be quietly bad rather than broken, which
# is exactly the failure a startup check is worth having for.
EMBEDDING_PROVIDER=hashing     # hashing | openai
OPENAI_API_KEY=                # embeddings only — Anthropic has no embeddings API
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536      # must equal document_chunks.embedding's width
EMBEDDING_BATCH_SIZE=96        # one request per chunk is 200 round trips per doc
# 400/60 is a starting point, not a finding. M8's harness exists to replace
# these with numbers measured against a golden set.
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
RETRIEVAL_TOP_K=5              # every extra chunk is context somebody pays for

# --- Generation (M7) ---
# `offline` quotes the best-matching retrieved sentence instead of generating.
# REFUSED IN PRODUCTION: shipped to users it would answer every question with a
# document fragment — not a degraded product so much as a different, worse one.
LLM_PROVIDER=offline           # offline | anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_MAX_TOKENS=1024            # a ceiling on the answer, not the context
LLM_TEMPERATURE=0.0            # a RAG answer is summarisation, not creativity
LLM_TIMEOUT_SECONDS=60.0       # no timeout means a hang, not a failure
# The *budget*, not the model's window. Filling a 200k window with every
# plausible chunk costs real money per question and measurably degrades answers.
CONTEXT_TOKEN_BUDGET=8000

# --- Conversations & memory (M10) ---
# Separate from CONTEXT_TOKEN_BUDGET on purpose: one shared budget would let a
# long thread starve the retrieved documents, and answers would get worse as a
# conversation got longer with nothing in the logs to say why.
HISTORY_TOKEN_BUDGET=2000
# Smaller than RETRIEVAL_TOP_K deliberately — a memory is an uncited assertion,
# so it has to clear a higher bar than a citable chunk, not a lower one.
MEMORY_TOP_K=3

# --- Integrations (M11) ---
# `offline` is a complete in-memory authorization server: real codes, real
# expiry, real revocation, no Google. REFUSED IN PRODUCTION — it would let a
# user complete a connect flow and hold tokens Google never issued.
OAUTH_PROVIDER=offline         # offline | google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The public origin Google redirects back to. Configuration rather than derived
# from the request, because Google matches the redirect URI *exactly* and a
# forwarded Host header must not be able to change where a code is delivered.
# The full callback is <base>/api/v1/integrations/google_calendar/callback —
# register that in the Google console, character for character.
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
OAUTH_STATE_TTL_SECONDS=600    # longer than a consent screen, shorter than a nap
# Encrypts OAuth tokens at rest (Fernet). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REFUSED IN PRODUCTION as this placeholder, and refused if equal to SECRET_KEY.
# The value below is base64 of a readable ASCII string so anyone who decodes it
# can see immediately it is not a secret. Two keys, two blast radii: one signs
# our sessions, the other protects credentials to somebody else's account.
TOKEN_ENCRYPTION_KEY=YWdlbnRmbG93LWRldi1vbmx5LWluc2VjdXJlLWtleSE=

# --- Approvals & pricing (M12) ---
APPROVAL_TTL_HOURS=24          # expiry is a safety property, not tidiness
# What this deployment pays per million tokens. Zero by default and deliberately
# so: a cost_usd of 0.000000 means "nobody has told this system what it pays",
# not "this run was free". Copy the numbers off your provider's pricing page.
LLM_INPUT_COST_PER_MTOK=0
LLM_OUTPUT_COST_PER_MTOK=0

# =============================================================================
# NOT READ YET — declared here so the shape of later milestones is visible.
# `Settings` ignores unknown keys, so these are harmless; it also means a typo
# in one is silent, which is why they are kept apart from the live settings.
# =============================================================================

# --- More integrations (M14) ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Production hardening (M16) ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
