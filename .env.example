# =============================================================================
# AgentFlow AI — environment template
# Copy to `.env` and fill in real values. `.env` is gitignored; this file is
# the committed contract of every variable the app needs.
# =============================================================================

# --- App ---
APP_ENV=development            # development | staging | production
APP_NAME=agentflow
LOG_LEVEL=INFO
SECRET_KEY=change-me           # JWT signing key: `openssl rand -hex 32`
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://agentflow:agentflow@localhost:5432/agentflow

# --- Redis (cache + task queue broker) ---
REDIS_URL=redis://localhost:6379/0

# --- LLM providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=                # optional, for embeddings or model comparison
DEFAULT_MODEL=claude-sonnet-5

# --- Vector store ---
# We start with pgvector inside PostgreSQL, so no extra URL is needed.

# --- OAuth: Google (Gmail, Calendar, Drive) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback

# --- OAuth: Slack ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# --- OAuth: Notion ---
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# --- OAuth: GitHub ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Stripe ---
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Observability ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
