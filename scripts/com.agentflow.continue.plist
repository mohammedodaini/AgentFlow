<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd job that runs one unattended AgentFlow session per day.

  launchd rather than cron, and rather than a Claude-side scheduler: a job
  created inside a Claude session lives only in that session, so it cannot
  survive the session ending — which is the entire thing being asked for here.
  Only the OS can start a process tomorrow.

  Install:
      cp scripts/com.agentflow.continue.plist ~/Library/LaunchAgents/
      launchctl load ~/Library/LaunchAgents/com.agentflow.continue.plist

  Run once immediately, to check it works:
      launchctl start com.agentflow.continue
      tail -f backend/var/logs/launchd.out

  Stop it, in increasing order of permanence:
      touch backend/var/STOP                  # skip runs, keep the schedule
      launchctl stop com.agentflow.continue   # kill the run in progress
      launchctl unload ~/Library/LaunchAgents/com.agentflow.continue.plist

  Paths are absolute because launchd runs with almost no environment — no PATH
  from your shell profile, no Homebrew, nothing. Every one of them has to be
  edited if the username is not `mohammedalodini`.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agentflow.continue</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/mohammedalodini/AgentFlow/scripts/continue-agentflow.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/mohammedalodini/AgentFlow</string>

    <!--
      09:00 daily. One run a day rather than a loop: docs/CONTINUE.md tells the
      session to build exactly one milestone and stop, so a human sees each one
      before the next is built on top of it.

      If the machine is asleep at 09:00, launchd runs the job when it next
      wakes rather than skipping the day.

      RunAtLoad is deliberately absent. A job that fires the moment you install
      it gives you no chance to read the script first.
    -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!--
      launchd's own view of the job. The script keeps a per-run log in the same
      directory; these two catch anything that goes wrong *before* the script
      gets far enough to redirect its own output.
    -->
    <key>StandardOutPath</key>
    <string>/Users/mohammedalodini/AgentFlow/backend/var/logs/launchd.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/mohammedalodini/AgentFlow/backend/var/logs/launchd.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- Homebrew and ~/.local/bin are not on launchd's PATH. Without this,
             `claude`, `uv`, `docker` and `colima` are all "command not found",
             and the failure appears in launchd.err rather than anywhere the
             script can explain it. -->
        <key>PATH</key>
        <string>/Users/mohammedalodini/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/mohammedalodini</string>
    </dict>
</dict>
</plist>
