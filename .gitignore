
!.env.example
!.vscode/extensions.json
!.vscode/settings.json
# --- Docker / data volumes ---
# --- Environment / secrets (NEVER commit these) ---
# --- IDE / OS ---
# --- Local runtime state (M5) ---
# --- Node / frontend ---
# --- Python ---
# --- Tooling caches ---
# Uploaded document bytes land here with STORAGE_BACKEND=local. Customer files
# a twelve-factor app generates rather than reads from configuration.
# must never reach a repository, and `var/` is the conventional home for state
*.egg-info/
*.key
*.pem
*.py[cod]
*.sqlite3
.DS_Store
.coverage
.eggs/
.env
.env.*
.idea/
.mypy_cache/
.next/
.pytest_cache/
.ruff_cache/
.venv/
.vscode/*
__pycache__/
backend/.venv/
backend/var/
backups/
build/
coverage.xml
credentials*.json
dist/
frontend/.env*
htmlcov/
node_modules/
out/
pgdata/
token*.json
var/
venv/

# Generated by the supply-chain CI job: the lockfile exported to the format
# pip-audit reads. Regenerated on every run and never a source of truth.
backend/requirements.audit.txt

# Scratch output from a manual gitleaks run; CI prints its findings instead.
.gitleaks-report.json
