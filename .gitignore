# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# --- Environment / secrets (NEVER commit these) ---
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
token*.json

# --- Local runtime state (M5) ---
# Uploaded document bytes land here with STORAGE_BACKEND=local. Customer files
# must never reach a repository, and `var/` is the conventional home for state
# a twelve-factor app generates rather than reads from configuration.
var/
backend/var/

# --- Tooling caches ---
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# --- Node / frontend ---
node_modules/
.next/
out/
frontend/.env*

# --- IDE / OS ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store

# --- Docker / data volumes ---
*.sqlite3
pgdata/
backend/.venv/
backups/
